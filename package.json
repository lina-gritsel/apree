{
  "name": "sobrano",
  "version": "1.0.0",
  "private": true,
  "description": "A thoughtfully crafted full-stack kanban board",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @sobrano/api\" \"npm run dev -w @sobrano/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint apps tests playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @sobrano/api",
    "db:migrate": "npm run db:migrate -w @sobrano/api",
    "db:seed": "npm run db:seed -w @sobrano/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
