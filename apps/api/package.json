{
  "name": "@sobrano/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- node --watch --require ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test prisma/seed.ts",
    "test": "node --require ts-node/register --test test/*.test.ts",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "dotenv-cli": "^8.0.0"
  }
}
